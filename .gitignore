.DS_Store

.idea
.vscode/*
!.vscode/settings.json
!.vscode/user_settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/keybindings.json

__pycache__
.python-version
.venv*
*.egg-info
.pi-lens

.aim

/.config/yazi/plugins

# Claude Code auto-generated project files
/.claude/settings.local.json
/.claude/backups
/.claude/cache
/.claude/debug
/.claude/plugins
/.claude/projects
/.claude/session-env
/.claude/shell-snapshots
/.claude/todos
/.claude/history.jsonl
# Codex writes credentials, databases, caches, sessions, packages, and plugins
# beside its durable configuration. Track only the configuration allowlist.
/.codex/*
!/.codex/AGENTS.md
!/.codex/config.toml
!/.codex/*.config.toml
!/.codex/agents/
!/.codex/agents/**
!/.codex/rules/
!/.codex/rules/**
# Codex appends remembered TUI approvals here at runtime.
/.codex/rules/default.rules

# pi writes credentials, trust decisions, sessions, caches, npm packages, and a
# fetched model catalog beside its durable configuration. Track only the
# configuration allowlist.
/.pi/*
!/.pi/agent/
# Model and workflow settings only. API keys belong in env vars, never here.
!/.pi/web-search.json
/.pi/agent/*
!/.pi/agent/settings.json
!/.pi/agent/models.json
!/.pi/agent/keybindings.json
!/.pi/agent/agents/
!/.pi/agent/agents/**
!/.pi/agent/extensions/
!/.pi/agent/extensions/**

/.config/opencode/package-lock.json

# Sensitive local config files (safety net)
.env-global.sh
.gitconfig.local
