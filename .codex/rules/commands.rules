# Command permissions migrated from .claude/settings.json.
#
# These rules apply when a command needs to run outside the sandbox. Commands
# that stay inside the workspace or /tmp are governed by the workspace sandbox
# and do not need an allow rule.

prefix_rule(
    pattern = [[
        "pre-commit",
        "ruff",
        "uv",
        "grep",
        "cat",
        "head",
        "tail",
        "less",
        "wc",
        "file",
        "tree",
        "ls",
        "sed",
        "find",
        "stat",
        "du",
        "diff",
        "realpath",
        "readlink",
        "which",
        "type",
        "env",
        "echo",
        "pwd",
        "basename",
        "dirname",
        "id",
        "whoami",
        "hostname",
        "date",
        "uname",
        "printenv",
        "sort",
        "uniq",
        "cut",
        "awk",
        "xargs",
        "jq",
        "yq",
        "shasum",
        "md5",
        "df",
        "squeue",
        "tmux",
    ]],
    decision = "allow",
    justification = "Match the general command access granted in Claude Code.",
    match = [
        "uv run pyright src",
        "find . -type f",
    ],
    not_match = [
        "bash -lc pwd",
        "npx prettier README.md",
        "rg is intentionally excluded",
    ],
)

prefix_rule(
    pattern = ["chmod", "+x"],
    decision = "allow",
    justification = "Match Claude Code's permission to mark files executable.",
    match = ["chmod +x script.sh"],
    not_match = ["chmod 777 script.sh"],
)

prefix_rule(
    pattern = ["npx", "prettier"],
    decision = "allow",
    justification = "Match Claude Code's permission to format files with Prettier.",
    match = ["npx prettier --write README.md"],
    not_match = ["npx eslint ."],
)

prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Match Claude Code's general Git permission; destructive overrides remain prompts.",
    match = [
        "git status --short",
        "git add README.md",
        "git commit -m docs",
    ],
)

prefix_rule(
    pattern = ["glab", "auth", "status"],
    decision = "allow",
    justification = "Allow read-only GitLab authentication checks.",
    match = [
        "glab auth status",
    ],
)

prefix_rule(
    pattern = ["glab", "mr", ["view", "list", "diff"]],
    decision = "allow",
    justification = "Allow read-only merge request inspection.",
    match = [
        "glab mr view 12",
        "glab mr list",
        "glab mr diff 12",
    ],
)

prefix_rule(
    pattern = ["glab", "issue", ["view", "list"]],
    decision = "allow",
    justification = "Allow read-only issue inspection.",
    match = [
        "glab issue view 12",
        "glab issue list",
    ],
)

prefix_rule(
    pattern = ["glab", "repo", "view"],
    decision = "allow",
    justification = "Allow read-only repository inspection.",
    match = [
        "glab repo view",
    ],
)

prefix_rule(
    pattern = ["glab", "release", ["view", "list"]],
    decision = "allow",
    justification = "Allow read-only release inspection.",
    match = [
        "glab release view v1.0.0",
        "glab release list",
    ],
)

prefix_rule(
    pattern = ["node", ".codex/skills/.system/openai-docs/scripts/fetch-codex-manual.mjs"],
    decision = "allow",
    justification = "Allow the bundled OpenAI documentation helper to refresh its cache.",
)

prefix_rule(
    pattern = ["/bin/bash", "-lc", "GIT_EDITOR=true git rebase --continue"],
    decision = "allow",
    justification = "Allow the established non-interactive rebase continuation command.",
)
